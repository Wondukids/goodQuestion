# 이 파일은 Stop 훅(.claude/hooks/env-example.sh)이 자동으로 채웁니다.
# 실제 값은 .env.local 에 두고, 이 파일에는 키 이름만 남겨 두세요.

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# Google Cloud API 키 (Speech-to-Text·Text-to-Speech 활성화 필요). 실제 값은 .env.local 에.
GOOGLE_CLOUD_API_KEY=

# Gemini API 키 (aistudio.google.com 에서 발급) — 있으면 TTS 가 Gemini 2.5 Flash 로 동작
GEMINI_API_KEY=

# ── 대화 엔진 (이슈 #26 이식) ────────────────────────────────────────────
# ⚠️ 아래 GQ_* 는 Stop 훅이 **못 채운다.** 훅은 `process.env.X` 리터럴만 훑는데
#    src/lib/config.ts 는 이름을 변수로 넘겨 읽는다. 그래서 손으로 적어 둔다.

# 없으면 아무것도 안 돈다 (src/lib/repo/db.ts)
DATABASE_URL=

# 🔴 저쪽 TTS 용 GEMINI_API_KEY 와 **다른 변수다.** 이름을 갈라 두어야 할당량과
#    청구가 안 섞인다 (근거는 src/lib/config.ts 의 GEMINI_키_이름들 주석).
#    같은 키를 쓰고 싶으면 두 이름에 같은 값을 적으면 된다.
#    _2·_3 은 선택 — 한도에 걸리면 적힌 순서대로 넘어간다.
GQ_GEMINI_API_KEY=
GQ_GEMINI_API_KEY_2=
GQ_GEMINI_API_KEY_3=

# 🔴 회차를 시작할 때 `story_sessions.child_id` 에 넣을 값 (결정 71).
#    없으면 회차 시작이 이름을 대고 **터진다.** 그전에는 `gen_random_uuid()` 로 없는 아이를
#    회차마다 지어냈는데, 이 레포의 `story_sessions.child_id` 에는 `children` FK 가 걸려 있어
#    그 값이 100% 튕긴다. 지어낸 값을 조용히 흘려보내느니 멈추는 편이 낫다.
#    ⚠️ 실재하는 `children.id` 여야 한다. 실험용 아이 한 벌이 이미 DB 에 있다
#    (로그인 불가한 자리표다 — 진짜 아이가 아니다).
GQ_EXPERIMENT_CHILD_ID=

# fallback (API 에러·네트워크 실패·타임아웃일 때만 발동)
ANTHROPIC_API_KEY=

# 검수용 두 번째 줄. 체인에는 안 탄다 — 되풀이는 무료 flash-lite 로 한다
OPENAI_API_KEY=

# 아래는 전부 기본값이 있어 **생략 가능**하다 (src/lib/config.ts loadSettings)
GQ_GEMINI_MODEL=
GQ_ANTHROPIC_MODEL=
GQ_OPENAI_MODEL=
GQ_GEMINI_EFFORT=
GQ_ANTHROPIC_EFFORT=
GQ_OPENAI_EFFORT=
GQ_LLM_TIMEOUT_SECONDS=
GQ_LLM_RPM=
GQ_PRICING_FILE=
