# 이 파일은 Stop 훅(.claude/hooks/env-example.sh)이 자동으로 채웁니다.
# 실제 값은 .env.local 에 두고, 이 파일에는 키 이름만 남겨 두세요.

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# Google Cloud API 키 (Speech-to-Text·Text-to-Speech 활성화 필요). 실제 값은 .env.local 에.
GOOGLE_CLOUD_API_KEY=

# Gemini API 키 (aistudio.google.com/apikey 에서 무료 발급) — TTS 용.
# 없으면 TTS 는 Google Cloud 로 동작합니다.
GEMINI_API_KEY=

# 홈 추천 큐레이션용 Gemini 키 — TTS 와 겹치지 않게 용도별로 분리.
# 없으면 추천은 규칙 기반 무료 모드로 동작합니다.
GEMINI_RECOMMEND_API_KEY=

NODE_ENV=
